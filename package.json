{
  "name": "image-cache-pro",
  "private": false,
  "version": "0.6.0",
  "type": "module",
  "description": "Advanced JavaScript library for image loading, pre-loading, caching, and detailed RAM & GPU memory management. (Beta)",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist/**/*",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "license": "MIT",
  "author": {
    "name": "Samvel Avanesov",
    "email": "sam.avanesoff@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/savanesoff/image-cache-pro"
  },
  "packageManager": "pnpm@11.15.1",
  "keywords": [
    "image cache",
    "image loading",
    "image pre-loading",
    "image pre-rendering",
    "RAM management",
    "GPU management",
    "web performance",
    "image optimization",
    "memory management",
    "typescript"
  ],
  "release": {
    "branches": [
      "main"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10"
  },
  "bugs": {
    "url": "https://github.com/savanesoff/image-cache-pro/issues"
  },
  "homepage": "https://github.com/savanesoff/image-cache-pro#readme",
  "scripts": {
    "dev": "vite --config vite.config.demo.ts",
    "build:demo": "vite build --config vite.config.demo.ts",
    "preview:demo": "vite preview --config vite.config.demo.ts",
    "test:e2e": "playwright test",
    "lint": "prettier --check . && eslint .",
    "lint-fix": "prettier --write . && eslint . --fix",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit",
    "test": "vitest --run",
    "test:watch": "vitest",
    "coverage": "vitest --run --coverage",
    "prepack": "pnpm run build",
    "clean:package": "rm -rf ./dist",
    "build:package": "pnpm run clean:package && vite build",
    "release": "pnpm run build:package && pnpm run test && pnpm changeset publish",
    "build": "pnpm run build:package"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.0.0",
    "@vitejs/plugin-legacy": "^8.2.1",
    "@vitest/eslint-plugin": "^1.6.23",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "terser": "^5.49.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10"
  }
}
